library(readxl)
icu <- read_excel("~/Downloads/icu.xlsx")
View(icu)
library(tidyverse)
dados <- read_excel("~/Downloads/icu.xlsx")
head(dados)
hist(dados$icu_days, main = "Distribuição global de icu_days", xlab = "Dias de internamento")
hist(dados$age, main = "Distribuição global de age", xlab = "Idade")
boxplot(dados$icu_days, main = "Boxplot global de icu_days", ylab = "Dias")
boxplot(dados$age, main = "Boxplot global de age", ylab = "Idade")
qqnorm(dados$icu_days, main = "QQ-plot global de icu_days")
qqline(dados$icu_days, col = "red")
qqnorm(dados$age, main = "QQ-plot global de age")
qqline(dados$age, col = "red")
shapiro.test(dados$icu_days)
shapiro.test(dados$age)
# --- POR GRUPO ---
boxplot(icu_days ~ previous, data = dados,
main = "icu_days por estado prévio",
xlab = "Estado prévio", ylab = "Dias de internamento")
boxplot(age ~ previous, data = dados,
main = "Age por estado prévio",
xlab = "Estado prévio", ylab = "Idade")
par(mfrow = c(1, 3))
qqnorm(saudavel$icu_days,    main = "QQ-plot icu_days — Saudável")
qqline(saudavel$icu_days,    col = "red")
library(readxl)
icu <- read_excel("~/Downloads/icu.xlsx")
View(icu)
library(tidyverse)
dados <- read_excel("~/Downloads/icu.xlsx")
saudavel    <- subset(dados, previous == "healthy")
cronica_nao <- subset(dados, previous == "chronic_disease_without_disability")
cronica_sim <- subset(dados, previous == "chronic_disease_with_disability")
head(dados)
hist(dados$icu_days, main = "Distribuição global de icu_days", xlab = "Dias de internamento")
hist(dados$age, main = "Distribuição global de age", xlab = "Idade")
boxplot(dados$icu_days, main = "Boxplot global de icu_days", ylab = "Dias")
boxplot(dados$age, main = "Boxplot global de age", ylab = "Idade")
qqnorm(dados$icu_days, main = "QQ-plot global de icu_days")
qqline(dados$icu_days, col = "red")
qqnorm(dados$age, main = "QQ-plot global de age")
qqline(dados$age, col = "red")
shapiro.test(dados$icu_days)
shapiro.test(dados$age)
# --- POR GRUPO ---
boxplot(icu_days ~ previous, data = dados,
main = "icu_days por estado prévio",
xlab = "Estado prévio", ylab = "Dias de internamento")
boxplot(age ~ previous, data = dados,
main = "Age por estado prévio",
xlab = "Estado prévio", ylab = "Idade")
par(mfrow = c(1, 3))
qqnorm(saudavel$icu_days,    main = "QQ-plot icu_days — Saudável")
qqline(saudavel$icu_days,    col = "red")
qqnorm(cronica_nao$icu_days, main = "QQ-plot icu_days — Crónica não incapacitante")
qqline(cronica_nao$icu_days, col = "red")
qqnorm(cronica_sim$icu_days, main = "QQ-plot icu_days — Crónica incapacitante")
qqline(cronica_sim$icu_days, col = "red")
par(mfrow = c(1, 1))
par(mfrow = c(1, 3))
qqnorm(saudavel$age,    main = "QQ-plot age — Saudável")
qqline(saudavel$age,    col = "red")
qqnorm(cronica_nao$age, main = "QQ-plot age — Crónica não incapacitante")
qqline(cronica_nao$age, col = "red")
qqnorm(cronica_sim$age, main = "QQ-plot age — Crónica incapacitante")
qqline(cronica_sim$age, col = "red")
par(mfrow = c(1, 1))
shapiro.test(saudavel$icu_days)
shapiro.test(cronica_nao$icu_days)
shapiro.test(cronica_sim$icu_days)
shapiro.test(saudavel$age)
shapiro.test(cronica_nao$age)
shapiro.test(cronica_sim$age)
aggregate(age ~ previous, data = icu,function(x) c(mean = mean(x), sd = sd(x)))
aggregate(icu_days ~ previous, data = icu,
function(x) c(median = median(x),
Q1 = quantile(x, 0.25),
Q3 = quantile(x, 0.75)))
boxplot(dados$icu_days, main = "Boxplot global de icu_days", ylab = "Dias")
install.packages(c("tidyverse", "here", "gtsummary", "gt", "janitor"))
library(tidyverse)
library(here)
library(janitor)
library(gtsummary)
library(gt)
library(tidyverse)
library(here)
library(janitor)
library(gtsummary)
library(gt)
dados <- read_csv(here("data", "raw", "mindmove.csv")) %>% clean_names()
glimpse(dados)
summary(dados)
dados |> summarise(across(everything(), ~ sum(is.na(.x))))
dados <- dados |>
mutate(reducao_phq9 = phq9_baseline - phq9_semana8)
tabela_basal_fmt <- dados |>
select(grupo, idade, sexo, phq9_baseline, gad7_baseline) |> # Variáveis do teu CSV
tbl_summary(
by = grupo,
label = list(
idade         ~ "Idade (anos)",
sexo          ~ "Sexo",
phq9_baseline ~ "Depressão Basal (PHQ-9)",
gad7_baseline ~ "Ansiedade Basal (GAD-7)"
),
statistic = list(
all_continuous()  ~ "{mean} ({sd})",
all_categorical() ~ "{n} ({p}%)"
),
digits = all_continuous() ~ 1,
missing = "no"
) |>
add_overall() |>
modify_header(label ~ "**Variável**")
tabela_basal_fmt
tabela_basal_fmt |>
as_gt() |>
gt::gtsave(here("outputs", "tabelas", "tabela_basal.html"))
fig_outcome <- ggplot(
dados |> filter(!is.na(phq9_semana8)),
aes(x = grupo, y = phq9_semana8, colour = grupo)
) +
geom_boxplot(outlier.shape = NA, width = 0.4, linewidth = 0.7) +
geom_jitter(width = 0.12, alpha = 0.7, size = 2.5) +
scale_colour_manual(
values = c("intervencao" = "#2C3E50", "controlo" = "#7A9B9E")
) +
labs(
x     = "Grupo",
y     = "Score PHQ-9 às 8 semanas",
title = "MindMove: Outcome Primário"
) +
theme_minimal(base_size = 13) +
theme(legend.position = "none")
fig_outcome
ggsave(
here("outputs", "figuras", "figura_outcome.png"),
plot   = fig_outcome,
width  = 6,
height = 4,
dpi    = 150
)
git fetch origin
